#ifndef _TERMMAP_CHAMP_H_
#define _TERMMAP_CHAMP_H_

#include "term_typedef.h"
#include <stddef.h>
#include <stdbool.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

struct GlobalContext;
typedef struct GlobalContext GlobalContext;
struct Heap;
typedef struct Heap Heap;

/** @brief Heap words termmap_champ_build will need for these hashes. */
size_t termmap_champ_build_size(const term *keys, const uint32_t *hashes, int n);

/** @brief Bulk-build a CHAMP from n entries whose hashes are precomputed. */
term termmap_champ_build(const term *keys, const term *values, const uint32_t *hashes, int n, Heap *heap);

/** @brief Look up key, or term_invalid_term() if absent. */
term termmap_champ_get(term node, term key, GlobalContext *global);

/**
 * @brief Insert or update key, sharing every untouched subtree.
 * @param added set to true when the key was not already present
 */
term termmap_champ_put(Heap *heap, term node, term key, term value, GlobalContext *global, bool *added);

/** @brief Heap words to reserve before one termmap_champ_put. */
size_t termmap_champ_put_heap_size(void);

/**
 * @brief Remove key, sharing every untouched subtree and restoring the
 * canonical form (a subtree that collapses to one entry is inlined into its
 * parent, which is what keeps CHAMP's representation unique).
 * @param found set to true when the key was present
 */
term termmap_champ_remove(Heap *heap, term node, term key, GlobalContext *global, bool *found);

/** @brief Heap words to reserve before one termmap_champ_remove. */
size_t termmap_champ_remove_heap_size(void);

/** @brief Number of entries in the subtree (walks it; for tests). */
size_t termmap_champ_count(term node);

#ifdef __cplusplus
}
#endif

