+    } else {
+        for (int i = 0; i < n; i++) { ks[i] = term_get_map_key(map, i); vs[i] = term_get_map_value(map, i); }
+    }
+    { int i = 0; for (term l = del; term_is_nonempty_list(l); l = term_get_list_tail(l)) { dks[i++] = term_get_list_head(l); } }
