+// PROTOTYPE TEST HOOK: drive the CHAMP core against a reference map built by
+// the shipped implementation. atomvm:champ_check(Map, DeleteKeys) checks, for
+// a CHAMP built by repeated put from Map's entries: every key resolves to the
+// same value, absent keys are absent, the entry count matches, and after
+// removing DeleteKeys the same holds for the remainder -- plus the canonical
+// invariant that no sub-node holds a single entry.
+static bool champ_canonical(term node, int depth)
+{
+    if (term_is_nil(node)) {
+        return true;
+    }
+    if (term_to_int(term_get_tuple_element(node, 0)) < 0) {
+        return true;
+    }
+    size_t arity = term_get_size_from_boxed_header(term_to_const_term_ptr(node)[0]);
+    uint32_t datamap = (uint32_t) term_to_int(term_get_tuple_element(node, 0));
+    uint32_t nodemap = (uint32_t) term_to_int(term_get_tuple_element(node, 1));
+    size_t entries = (size_t) __builtin_popcount(datamap);
+    size_t nodes = (size_t) __builtin_popcount(nodemap);
+    if (arity != 2 + 2 * entries + nodes) {
+        return false;
+    }
+    if (depth > 0 && entries == 1 && nodes == 0) {
+        return false; // a lone entry must have been inlined into the parent
+    }
+    if (depth > 0 && entries == 0 && nodes == 0) {
+        return false; // empty sub-node
+    }
+    for (size_t i = 0; i < nodes; i++) {
+        if (!champ_canonical(term_get_tuple_element(node, 2 + 2 * entries + i), depth + 1)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// PROTOTYPE BENCH: build-by-insert and bulk-remove, both backends, timed in C.
+// atomvm:champ_bench(Map, DeleteKeys, Reps, champ|btree) -> {BuildUs, DelUs}.
+static term nif_champ_bench(Context *ctx, int argc, term argv[])
+{
+    UNUSED(argc);
+    GlobalContext *glb = ctx->global;
+    bool use_champ = (argv[3] == globalcontext_make_atom(glb, ATOM_STR("\x5", "champ")));
+    avm_int_t reps = term_to_int(argv[2]);
+    int n = term_get_map_size(argv[0]);
+    int ndel = 0;
+    for (term l = argv[1]; term_is_nonempty_list(l); l = term_get_list_tail(l)) {
+        ndel++;
+    }
+    term *ks = malloc(sizeof(term) * (size_t) n);
+    term *vs = malloc(sizeof(term) * (size_t) n);
+    term *dks = malloc(sizeof(term) * (size_t) (ndel ? ndel : 1));
+    term *arr = malloc(sizeof(term) * 2 * (size_t) n);
+
+    size_t per = use_champ ? termmap_champ_put_heap_size() : termtree_put_heap_size((size_t) n);
+    size_t reserve = ((size_t) reps * ((size_t) n + (size_t) ndel) + 8) * per;
+    if (UNLIKELY(memory_ensure_free_with_roots(ctx, reserve, 2, argv, MEMORY_CAN_SHRINK)
+            != MEMORY_GC_OK)) {
+        free(ks); free(vs); free(dks); free(arr);
+        RAISE_ERROR(OUT_OF_MEMORY_ATOM);
+    }
+    term map = argv[0];
+    if (term_is_map_tree(map)) {
+        termtree_fill_array(term_get_map_tree_root(map), arr);
+        for (int i = 0; i < n; i++) { ks[i] = arr[2 * i]; vs[i] = arr[2 * i + 1]; }
+    } else {
+        for (int i = 0; i < n; i++) { ks[i] = term_get_map_key(map, i); vs[i] = term_get_map_value(map, i); }
+    }
+    { int i = 0; for (term l = argv[1]; term_is_nonempty_list(l); l = term_get_list_tail(l)) { dks[i++] = term_get_list_head(l); } }
+
+    struct timespec t0, t1, t2;
+    term root = term_nil();
+    clock_gettime(CLOCK_MONOTONIC_RAW, &t0);
+    for (avm_int_t r = 0; r < reps; r++) {
+        root = term_nil();
+        for (int i = 0; i < n; i++) {
+            if (use_champ) {
+                bool added;
+                root = termmap_champ_put(&ctx->heap, root, ks[i], vs[i], glb, &added);
+            } else {
+                root = termtree_put(&ctx->heap, root, ks[i], vs[i], glb);
+            }
+        }
+    }
+    clock_gettime(CLOCK_MONOTONIC_RAW, &t1);
+    for (avm_int_t r = 0; r < reps; r++) {
+        term cur = root;
+        for (int i = 0; i < ndel; i++) {
+            bool found;
+            cur = use_champ ? termmap_champ_remove(&ctx->heap, cur, dks[i], glb, &found)
+                            : termtree_remove(&ctx->heap, cur, dks[i], glb, &found);
+        }
+    }
+    clock_gettime(CLOCK_MONOTONIC_RAW, &t2);
+    free(ks); free(vs); free(dks); free(arr);
+
+    term res = term_alloc_tuple(2, &ctx->heap);
+    term_put_tuple_element(res, 0, term_from_int(
+        (t1.tv_sec - t0.tv_sec) * 1000000 + (t1.tv_nsec - t0.tv_nsec) / 1000));
+    term_put_tuple_element(res, 1, term_from_int(
+        (t2.tv_sec - t1.tv_sec) * 1000000 + (t2.tv_nsec - t1.tv_nsec) / 1000));
+    return res;
+}
