+    for (int i = 0; i < ndel; i++) {
+        bool found = false;
+        root = termmap_champ_remove(&ctx->heap, root, dks[i], glb, &found);
+        if (!found) { free(arr); free(ks); free(vs); free(dks); return term_from_int(-7); }
+        if (!champ_canonical(root, 0)) { free(arr); free(ks); free(vs); free(dks); return term_from_int(-8); }
+        bool again = true;
+        root = termmap_champ_remove(&ctx->heap, root, dks[i], glb, &again);
+        if (again) { free(arr); free(ks); free(vs); free(dks); return term_from_int(-9); }
+    }
+    if ((int) termmap_champ_count(root) != n - ndel) { free(arr); free(ks); free(vs); free(dks); return term_from_int(-10); }
