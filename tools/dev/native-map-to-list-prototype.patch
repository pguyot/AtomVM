+
+struct MapsToListState
+{
+    Heap *heap;
+    term result;
+};
+
+static inline term maps_pair(term key, term value, Heap *heap)
+{
+    term pair = term_alloc_tuple(2, heap);
+    term_put_tuple_element(pair, 0, key);
+    term_put_tuple_element(pair, 1, value);
+    return pair;
+}
+
+static void maps_to_list_entry(term key, term value, void *arg)
+{
+    struct MapsToListState *state = arg;
+    term pair = maps_pair(key, value, state->heap);
+    state->result = term_list_prepend(pair, state->result, state->heap);
+}
+
+static term nif_maps_to_list(Context *ctx, int argc, term argv[])
+{
+    UNUSED(argc);
+    if (term_is_map(argv[0])) {
+        term map = argv[0];
+        size_t n = term_get_map_size(map);
+        size_t need = n * (CONS_SIZE + TUPLE_SIZE(2));
+        if (context_avail_free_memory(ctx) < need
+            && UNLIKELY(memory_ensure_free_with_roots(ctx, need, 1, &map, MEMORY_CAN_SHRINK)
+                != MEMORY_GC_OK)) {
+            RAISE_ERROR(OUT_OF_MEMORY_ATOM);
+        }
+        struct MapsToListState state = { &ctx->heap, term_nil() };
+        if (term_is_map_hash(map)) {
+            termmap_champ_foreach(term_get_map_hash_root(map), maps_to_list_entry, &state);
+        } else {
+            for (size_t i = n; i-- > 0;) {
+                maps_to_list_entry(term_get_map_key(map, i), term_get_map_value(map, i), &state);
+            }
+        }
+        return state.result;
+    }
+
+    term roots[] = { argv[0], argv[0], term_nil() };
+    for (;;) {
+        term next = maps_next(ctx, roots, 3);
+        if (UNLIKELY(term_is_invalid_term(next))) {
+            if (ctx->exception_reason != BADARG_ATOM) {
+                return next;
+            }
+            if (UNLIKELY(memory_ensure_free_with_roots(ctx, TUPLE_SIZE(2), 3, roots, MEMORY_CAN_SHRINK)
+                    != MEMORY_GC_OK)) {
+                RAISE_ERROR(OUT_OF_MEMORY_ATOM);
+            }
+            term error = term_alloc_tuple(2, &ctx->heap);
+            term_put_tuple_element(error, 0, BADMAP_ATOM);
+            term_put_tuple_element(error, 1, roots[1]);
+            RAISE_ERROR(error);
+        }
+        if (next == NONE_ATOM) {
+            break;
+        }
+        roots[0] = next;
+        if (UNLIKELY(memory_ensure_free_with_roots(ctx, TUPLE_SIZE(2) + CONS_SIZE, 3, roots, MEMORY_CAN_SHRINK)
+                != MEMORY_GC_OK)) {
+            RAISE_ERROR(OUT_OF_MEMORY_ATOM);
+        }
+        next = roots[0];
+        term pair = maps_pair(term_get_tuple_element(next, 0),
+            term_get_tuple_element(next, 1), &ctx->heap);
+        roots[2] = term_list_prepend(pair, roots[2], &ctx->heap);
+        roots[0] = term_get_tuple_element(next, 2);
+    }
+
+    // A collection during iteration may have promoted part of the list.
+    // Allocate the reverse rather than introducing old-to-young references
+    // by changing the links of those promoted cells.
