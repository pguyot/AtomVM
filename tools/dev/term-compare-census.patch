+
+/**
+ * @file term_census.h
+ * @brief Instrumentation build: record every term comparison a workload makes.
+ *
+ * @details Compiled in only under -DAVM_TERM_CENSUS, and never in a build that
+ * is timed. Each logical comparison -- the outermost one; the walks it makes
+ * internally are part of it, not separate events -- is recorded once, with the
+ * pair re-examined after the fact to say what actually decided it. The point is
+ * to answer what a different representation of atoms or of boxed terms would be
+ * worth, so the record keeps the shape of the operands (types, arity, which
+ * element decided, how deep it went) rather than only a count, and the atom
+ * table keeps a separate record of how much of a name each ordering needed.
+ */
+
+#ifndef _TERM_CENSUS_H_
+#define _TERM_CENSUS_H_
+
+#ifdef AVM_TERM_CENSUS
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "term_typedef.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct GlobalContext;
+struct AtomTable;
+
+/** @brief True while the census is re-walking a pair to classify it. */
+bool term_census_analyzing(void);
+
+/**
+ * @brief Record one logical comparison, already resolved.
+ * @param ra return address of the caller, symbolized at dump time.
+ */
+void term_census_record(
+    void *ra, void *ra2, term a, term b, int opts, int result, struct GlobalContext *global);
+
+/** @brief Whether a nested (already accounted) comparison is running. */
+bool term_census_nested(void);
+void term_census_enter(int opts);
+void term_census_leave(void);
+
+/** @brief =:= as the map descents ask it, recorded at the real call site. */
+bool term_census_exact_eq(void *ra, void *ra2, term a, term b, struct GlobalContext *global);
+
+/** @brief One flat-map probe comparison resolved inline, without term_compare. */
+void term_census_probe(void *ra, void *ra2, term key, term candidate, int result);
+
+/** @brief One atom-vs-atom ordering decided by the atom table. */
+void term_census_atom_pair(struct AtomTable *table, uint32_t a_index, uint32_t b_index);
+
+/** @brief Write the census to $AVM_TERM_CENSUS_OUT (or stderr). Idempotent. */
+void term_census_dump(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
+
+#endif
