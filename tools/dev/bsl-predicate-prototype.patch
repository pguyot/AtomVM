+%% Fold a safe shift into an immediately following equality test when the
+%% shifted value is unobservable on both outgoing paths. Restrict speculative
+%% decoding to short x registers and literal integers: it emits no code.
+try_fuse_bsl_test(
+    erlang,
+    'bsl',
+    {typed, {x_reg, SrcX}, {t_integer, Range}} = Src,
+    ShiftTerm,
+    {x_reg, DestX},
+    Rest,
+    MMod,
+    MSt,
+    #state{live_masks = Masks}
+) when
+    SrcX < 16,
+    DestX < 16,
+    is_integer(ShiftTerm),
+    ShiftTerm band ?TERM_IMMED_TAG_MASK =:= ?TERM_INTEGER_TAG
+->
+    Shift = ShiftTerm bsr 4,
+    case
+        Shift > 0 andalso Shift < MMod:word_size() * 8 - 4 andalso
+            can_inline_bsl(Range, Shift, MMod)
+    of
+        true ->
+            fuse_bsl_comparison(Rest, DestX, Src, Shift, MMod, MSt, Masks);
+        false ->
+            not_fused
+    end;
+try_fuse_bsl_test(_, _, _, _, _, _, _, _, _) ->
+    not_fused.
+
+fuse_bsl_comparison(<<Op, Rest0/binary>>, DestX, Src, Shift, MMod, MSt, Masks) when
+    Op =:= ?OP_IS_EQ_EXACT; Op =:= ?OP_IS_NOT_EQ_EXACT
+->
+    {Label, Rest1} = decode_label(Rest0),
+    case scan_short_x_register(Rest1) of
+        {ok, DestX, Rest2} ->
+            case scan_int_compact_term(Rest2) of
+                {ok, Value, Rest3} ->
+                    case
+                        maps:get(Label, Masks, 16#FFFFFFFF) band (1 bsl DestX) =:= 0 andalso
+                            jit_liveness:x_register_dead(Rest3, DestX, Masks)
+                    of
+                        true ->
+                            {Min, Max} = small_integer_bounds(MMod),
+                            Preimage = Value bsr Shift,
+                            Possible =
+                                (Preimage bsl Shift) =:= Value andalso
+                                    Preimage >= Min andalso Preimage =< Max,
+                            MSt1 =
+                                case {Possible, Op} of
+                                    {true, ?OP_IS_EQ_EXACT} ->
+                                        op_is_eq_exact(
+                                            MMod, MSt, Label, Src, term_from_int(Preimage)
+                                        );
+                                    {true, ?OP_IS_NOT_EQ_EXACT} ->
+                                        op_is_not_eq_exact(
+                                            MMod, MSt, Label, Src, term_from_int(Preimage)
+                                        );
+                                    {false, ?OP_IS_EQ_EXACT} ->
+                                        MMod:jump_to_label(MSt, Label);
+                                    {false, ?OP_IS_NOT_EQ_EXACT} ->
+                                        MSt
+                                end,
+                            {fused, MSt1, Rest3};
+                        false ->
+                            not_fused
+                    end;
+                _ ->
+                    not_fused
+            end;
+        _ ->
+            not_fused
+    end;
+fuse_bsl_comparison(<<?OP_SELECT_VAL, Rest0/binary>>, DestX, Src, Shift, MMod, MSt, Masks) ->
+    case scan_short_x_register(Rest0) of
+        {ok, DestX, Rest1} ->
+            {Default, Rest2} = decode_label(Rest1),
+            {ListSize, Rest3} = decode_extended_list_header(Rest2),
+            case
+                ListSize =< 8 andalso scan_select_val_int_entries(Rest3, ListSize div 2, MMod, [])
+            of
+                {ok, Entries, Rest4} ->
+                    Labels = [Default | [L || {_, L} <- Entries]],
+                    case
+                        lists:all(
+                            fun(L) -> maps:get(L, Masks, 16#FFFFFFFF) band (1 bsl DestX) =:= 0 end,
+                            Labels
+                        )
+                    of
+                        true ->
+                            WordBits = MMod:word_size() * 8,
+                            {Min, Max} = small_integer_bounds(MMod),
+                            Preimages = lists:filtermap(
+                                fun({Tagged, Label}) ->
+                                    Signed =
+                                        case Tagged band (1 bsl (WordBits - 1)) of
+                                            0 -> Tagged;
+                                            _ -> Tagged - (1 bsl WordBits)
+                                        end,
+                                    Value = Signed bsr 4,
+                                    Preimage = Value bsr Shift,
+                                    case
+                                        (Preimage bsl Shift) =:= Value andalso Preimage >= Min andalso
+                                            Preimage =< Max
+                                    of
+                                        true -> {true, {term_from_int(Preimage), Label}};
+                                        false -> false
+                                    end
+                                end,
+                                Entries
+                            ),
+                            {MSt1, Reg} = MMod:move_to_native_register(MSt, unwrap_typed(Src)),
+                            MSt2 = lists:foldl(
+                                fun({Value, Label}, S) ->
+                                    cond_jump_to_label({Reg, '==', Value}, Label, MMod, S)
+                                end,
+                                MSt1,
+                                Preimages
+                            ),
+                            MSt3 = MMod:free_native_registers(MSt2, [Reg]),
+                            {fused, MMod:jump_to_label(MSt3, Default), Rest4};
+                        false ->
+                            not_fused
+                    end;
+                _ ->
+                    not_fused
+            end;
+        _ ->
+            not_fused
+    end;
+fuse_bsl_comparison(_, _, _, _, _, _, _) ->
+    not_fused.
+
+scan_short_x_register(<<?COMPACT_EXTENDED_TYPED_REGISTER, Rest/binary>>) ->
+    case scan_short_x_register(Rest) of
+        {ok, X, Rest1} ->
+            {_Type, Rest2} = decode_literal(Rest1),
+            {ok, X, Rest2};
+        _ ->
+            nomatch
+    end;
+scan_short_x_register(<<X:4, ?COMPACT_XREG:4, Rest/binary>>) ->
+    {ok, X, Rest};
+scan_short_x_register(_) ->
+    nomatch.
+
