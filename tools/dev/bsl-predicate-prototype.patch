+%% Query a short suffix without retaining per-instruction liveness maps.
+%% GC roots count as reads, as in the existing dead-move analysis. Unknown
+%% instructions and an exhausted scan budget conservatively keep the value.
+x_register_dead(Code, X, Masks) when X >= 0, X < 32 ->
+    x_register_dead0(Code, 1 bsl X, Masks, 64).
+
+x_register_dead0(<<>>, _Bit, _Masks, _Budget) ->
+    false;
+x_register_dead0(_Code, _Bit, _Masks, 0) ->
+    false;
+x_register_dead0(Code, Bit, Masks, Budget) ->
+    case op_scan(Code) of
+        {label, Label, _} ->
+            mask_in(Label, Masks) band Bit =:= 0;
+        {plain, Reads, Writes, Rest} ->
+            x_register_dead_step(Reads, Writes, Rest, Bit, Masks, Budget);
+        {branch, Reads, Writes, Labels, Rest} ->
+            masks_union(Labels, Masks) band Bit =:= 0 andalso
+                x_register_dead_step(Reads, Writes, Rest, Bit, Masks, Budget);
+        {terminator, Reads, Labels, _} ->
+            (mask_of(Reads) bor masks_union(Labels, Masks)) band Bit =:= 0;
+        {call, Reads, Writes, _Target, false, Rest} ->
+            x_register_dead_step(Reads, Writes, Rest, Bit, Masks, Budget);
+        {call, Reads, _Writes, Target, true, _} ->
+            (mask_of(Reads) bor mask_in(Target, Masks)) band Bit =:= 0;
+        unknown ->
+            false
+    end.
+
+x_register_dead_step(Reads, Writes, Rest, Bit, Masks, Budget) ->
+    mask_of(Reads) band Bit =:= 0 andalso
+        (mask_of(Writes) band Bit =/= 0 orelse
+            x_register_dead0(Rest, Bit, Masks, Budget - 1)).
+
