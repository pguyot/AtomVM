diff --git a/libs/jit/src/jit_aarch64.erl b/libs/jit/src/jit_aarch64.erl
index e4c1ed8b8..a59451cd3 100644
--- a/libs/jit/src/jit_aarch64.erl
+++ b/libs/jit/src/jit_aarch64.erl
@@ -97,6 +97,7 @@
     mul_overflow/3,
     div_/3,
     rem_/3,
+    divrem_pow2_tagged/4,
     supports_div/1,
     supports_fp/1,
     float_op/5,
@@ -4378,6 +4379,60 @@ rem_(
     Regs1 = jit_regs:invalidate_reg(jit_regs:invalidate_reg(Regs0, TempReg), DividendReg),
     {State#state{stream = Stream1, regs = Regs1}, DividendReg}.
 
+%% Truncate signed division toward zero while retaining the small-integer
+%% tag. For t = 16*x + 15, bias = (sign(t) & (2^k-1)) << 4:
+%%   tag(x div 2^k) = ((t + bias) asr k) | 15
+%%   tag(x rem 2^k) = ((t + bias) & (((2^k-1) << 4) | 15)) - bias.
+%% Only negative values receive a positive bias, so the addition cannot
+%% overflow even at the small-integer boundaries. The caller checked the tag.
+divrem_pow2_tagged(State, Reg, 0, div_) ->
+    {State, Reg};
+divrem_pow2_tagged(State0, Reg, 0, rem_) ->
+    {move_to_native_register(State0, ?TERM_INTEGER_TAG, Reg), Reg};
+divrem_pow2_tagged(
+    #state{stream_module = StreamModule, stream = Stream0, regs = Regs0} = State,
+    Reg,
+    1,
+    div_
+) ->
+    %% For a negative t, adding one carries through its all-one tag into
+    %% the integer field. After shifting and retagging this rounds x/2
+    %% toward zero. ADD extracts the sign bit in its shifted operand.
+    Code = <<
+        (jit_aarch64_asm:add(Reg, Reg, Reg, {lsr, 63}))/binary,
+        (jit_aarch64_asm:asr(Reg, Reg, 1))/binary,
+        (jit_aarch64_asm:orr(Reg, Reg, ?TERM_INTEGER_TAG))/binary
+    >>,
+    {State#state{stream = StreamModule:append(Stream0, Code),
+        regs = jit_regs:invalidate_reg(Regs0, Reg)}, Reg};
+divrem_pow2_tagged(
+    #state{stream_module = StreamModule, stream = Stream0, regs = Regs0} = State,
+    Reg,
+    Shift,
+    Op
+) ->
+    BiasReg = first_avail(jit_regs:available_regs(Regs0) band (bnot reg_bit(Reg))),
+    Mask = ((1 bsl Shift) - 1) bsl 4,
+    I1 = jit_aarch64_asm:asr(BiasReg, Reg, 63),
+    I2 = jit_aarch64_asm:and_(BiasReg, BiasReg, Mask),
+    I3 = jit_aarch64_asm:add(Reg, Reg, BiasReg),
+    Tail =
+        case Op of
+            div_ ->
+                <<
+                    (jit_aarch64_asm:asr(Reg, Reg, Shift))/binary,
+                    (jit_aarch64_asm:orr(Reg, Reg, ?TERM_INTEGER_TAG))/binary
+                >>;
+            rem_ ->
+                <<
+                    (jit_aarch64_asm:and_(Reg, Reg, Mask bor ?TERM_INTEGER_TAG))/binary,
+                    (jit_aarch64_asm:sub(Reg, Reg, BiasReg))/binary
+                >>
+        end,
+    Stream1 = StreamModule:append(Stream0, <<I1/binary, I2/binary, I3/binary, Tail/binary>>),
+    Regs1 = jit_regs:invalidate_reg(jit_regs:invalidate_reg(Regs0, BiasReg), Reg),
+    {State#state{stream = Stream1, regs = Regs1}, Reg}.
+
 %% aarch64 always supports native sdiv.
 -spec supports_div(state()) -> boolean().
 supports_div(_State) -> true.
