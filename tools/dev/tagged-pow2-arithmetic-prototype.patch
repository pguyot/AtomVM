+% Literal divisors use the new fast path; the test oracle below uses a
+% runtime divisor. Include the widest positive power fitting a 64-bit small.
+pow2_divrem(0, X) -> {id(X) div 1, id(X) rem 1};
+pow2_divrem(1, X) -> {id(X) div 2, id(X) rem 2};
+pow2_divrem(2, X) -> {id(X) div 4, id(X) rem 4};
+pow2_divrem(4, X) -> {id(X) div 16, id(X) rem 16};
+pow2_divrem(8, X) -> {id(X) div 256, id(X) rem 256};
+pow2_divrem(27, X) -> {id(X) div 134217728, id(X) rem 134217728};
+pow2_divrem(58, X) -> {id(X) div 288230376151711744, id(X) rem 288230376151711744}.
+
+test_pow2_divrem() ->
+    Values = [
+        -(1 bsl 80), -(1 bsl 59) - 1, -(1 bsl 59), -(1 bsl 59) + 1,
+        -257, -256, -255, -17, -16, -15, -3, -2, -1, 0, 1, 2, 3,
+        15, 16, 17, 255, 256, 257, (1 bsl 59) - 1, 1 bsl 59, 1 bsl 80
+    ],
+    lists:foreach(
+        fun(K) ->
+            D = id(1 bsl K),
+            lists:foreach(
+                fun(X) ->
+                    Expected = {X div D, X rem D},
+                    Expected = ?MODULE:pow2_divrem(K, X)
+                end,
+                Values
+            ),
+            lists:foreach(
+                fun(Bad) ->
+                    caught = try ?MODULE:pow2_divrem(K, Bad) of
+                        _ -> failed
+                    catch
+                        error:badarith -> caught
+                    end
+                end,
+                [foo, [], 0.5]
+            )
+        end,
+        [0, 1, 2, 4, 8, 27, 58]
+    ),
+    ok.
+
 % Dividend the compiler proves is an integer but whose range it does not know,
 % divided by a literal: {tr,_,{t_integer,any}} against {integer,3}. Neither the
 % shift-by-power-of-two form nor the unguarded inline divide applies, and the
@@ -377,6 +419,7 @@ start() ->
