diff --git a/src/libAtomVM/termmap_tree.c b/src/libAtomVM/termmap_tree.c
index 608e9c296..6770c21ed 100644
--- a/src/libAtomVM/termmap_tree.c
+++ b/src/libAtomVM/termmap_tree.c
@@ -774,6 +774,130 @@ static term push_leftmost(term node, term stack, Heap *heap)
