+// Integer-encoded cursor.
+//
+// The frame stack above satisfies one invariant: the node at level i+1 is
+// child[index_i] of the node at level i (push_leftmost descends through
+// child[0] with index 0, and a step that emits key[index] advances to
+// index+1 and descends into child[index+1]). So the nodes are recoverable by
+// descending from the root, and the whole cursor is just the indices --
+// which fit in a small integer, the shape BEAM's HAMT iterator uses.
+//
+// Layout: level count in the low TREE_PATH_DEPTH_BITS, then one
+// TREE_PATH_LEVEL_BITS index per level from the root down. A level count of 0
+// means "before the first entry", which is what maps:iterator/1's [0 | Map]
+// already produces. Indices run 0..BT_MAX_KEYS, so they need 6 bits.
+#define TREE_PATH_DEPTH_BITS 4
+#define TREE_PATH_LEVEL_BITS 6
+#define TREE_PATH_DEPTH_MASK ((1 << TREE_PATH_DEPTH_BITS) - 1)
+#define TREE_PATH_LEVEL_MASK ((1 << TREE_PATH_LEVEL_BITS) - 1)
+
+// A level count must fit TREE_PATH_DEPTH_BITS and the whole path must stay a
+// small integer. 64-bit terms leave room for every height a degree-BT_T tree
+// can reach; 32-bit terms do not, so deep trees there keep the heap cursor.
+#if UINTPTR_MAX > UINT32_MAX
+#define TREE_PATH_MAX_LEVELS 8
+#else
+#define TREE_PATH_MAX_LEVELS 3
+#endif
+
+_Static_assert(BT_MAX_KEYS <= TREE_PATH_LEVEL_MASK,
+    "a B-tree key/child index must fit TREE_PATH_LEVEL_BITS");
+_Static_assert(TREE_PATH_MAX_LEVELS <= TREE_PATH_DEPTH_MASK,
+    "a level count must fit TREE_PATH_DEPTH_BITS");
+
+bool termtree_path_supported(term root)
+{
+    return descent_depth(root) <= TREE_PATH_MAX_LEVELS;
+}
+
+// Descend from `node` through child[0], recording a frame per level, exactly
+// as push_leftmost does but into the caller's arrays. Returns the new depth.
+static size_t path_push_leftmost(term node, term *nodes, size_t *idx, size_t depth)
+{
+    while (!term_is_nil(node) && depth < TREE_PATH_MAX_LEVELS) {
+        nodes[depth] = node;
+        idx[depth] = 0;
+        depth++;
+        if (node_is_leaf(node)) {
+            break;
+        }
+        node = node_child(node, 0);
+    }
+    return depth;
+}
+
+// Rebuild the frame stack an encoded path denotes. A path of 0 starts at the
+// leftmost entry.
+static size_t path_decode(term root, avm_int_t path, term *nodes, size_t *idx)
+{
+    size_t depth = (size_t) (path & TREE_PATH_DEPTH_MASK);
+    if (depth == 0) {
+        return path_push_leftmost(root, nodes, idx, 0);
+    }
+    term node = root;
+    for (size_t i = 0; i < depth; i++) {
+        nodes[i] = node;
+        idx[i] = (size_t) ((path >> (TREE_PATH_DEPTH_BITS + i * TREE_PATH_LEVEL_BITS))
+            & TREE_PATH_LEVEL_MASK);
+        if (i + 1 < depth) {
+            node = node_child(node, idx[i]);
+        }
+    }
+    return depth;
+}
+
+static avm_int_t path_encode(size_t depth, const size_t *idx)
+{
+    avm_int_t encoded = (avm_int_t) depth;
+    for (size_t k = 0; k < depth; k++) {
+        encoded |= ((avm_int_t) idx[k]) << (TREE_PATH_DEPTH_BITS + k * TREE_PATH_LEVEL_BITS);
+    }
+    return encoded;
+}
+
+// Same walk as termtree_cursor_next: drop exhausted frames, emit at the first
+// that still has a key, then descend to the next leaf in order.
+static bool path_step(term *nodes, size_t *idx, size_t *depth, term *key, term *value)
+{
+    while (*depth > 0) {
+        term node = nodes[*depth - 1];
+        size_t i = idx[*depth - 1];
+        if (i < node_nkeys(node)) {
+            *key = node_key(node, i);
+            *value = node_value(node, i);
+            idx[*depth - 1] = i + 1;
+            if (!node_is_leaf(node)) {
+                *depth = path_push_leftmost(node_child(node, i + 1), nodes, idx, *depth);
+            }
+            return true;
+        }
+        (*depth)--;
+    }
+    return false;
+}
+
+size_t termtree_path_next_chunk(term root, avm_int_t path, term *out_kv, size_t max, avm_int_t *next_path)
+{
+    term nodes[TREE_PATH_MAX_LEVELS];
+    size_t idx[TREE_PATH_MAX_LEVELS];
+    size_t depth = path_decode(root, path, nodes, idx);
+    size_t n = 0;
+    while (n < max) {
+        term key;
+        term value;
+        if (!path_step(nodes, idx, &depth, &key, &value)) {
+            *next_path = -1;
+            return n;
+        }
+        out_kv[2 * n] = key;
+        out_kv[2 * n + 1] = value;
+        n++;
+    }
+    *next_path = path_encode(depth, idx);
+    return n;
+}
+
 size_t termtree_cursor_reserve(term root, bool first)
 {
     // A step advances one frame and may then descend to a leaf, so it pushes
