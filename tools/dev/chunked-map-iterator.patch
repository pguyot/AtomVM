+// Entries one maps:next/1 call materializes as a chain. A fixed chunk is the
+// wrong shape: it amortizes the descent for a full traversal but wastes the
+// whole chunk for a caller that stops after one entry, and early-exit folds
+// (sets:is_disjoint/2, the compiler's subset checks) are common enough that a
+// fixed chunk of 8 measured 1% SLOWER on unicode_util.erl than no chunking.
+//
+// So the chunk doubles: 1, 2, 4, up to MAPS_NEXT_CHUNK_MAX. A caller taking
+// one entry materializes exactly one; a full traversal reaches the maximum
+// after three calls and allocates at most 2x what it uses. The size is
+// carried in the low MAPS_NEXT_HINT_BITS of the cursor integer, above the
+// position (flat) or the encoded tree path, so iterator(Map) -> [0 | Map]
+// still means "start, smallest chunk" with no special case.
+#define MAPS_NEXT_CHUNK_MAX 8
+#define MAPS_NEXT_HINT_BITS 3
+#define MAPS_NEXT_HINT_MASK ((1 << MAPS_NEXT_HINT_BITS) - 1)
+#define MAPS_NEXT_HINT_LAST 3
+
+static inline size_t maps_next_chunk_of(avm_int_t hint)
+{
+    size_t chunk = (size_t) 1 << (size_t) hint;
+    return chunk > MAPS_NEXT_CHUNK_MAX ? MAPS_NEXT_CHUNK_MAX : chunk;
+}
