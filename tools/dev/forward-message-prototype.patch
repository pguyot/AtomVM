 %% Skip past one DEST register encoding.
+%% A forwarding receive: the clause that just consumed a message is about to
+%% send it on, and nothing derived from it survives. When that holds, the
+%% incoming message block can be handed to the next process with a couple of
+%% immediate words patched instead of being sized and copied into a fresh one.
+%%
+%% Recognised conservatively, by shape alone: only immediate-producing opcodes
+%% may stand between the remove_message and the send, and the send must be
+%% followed by an overwrite of x0 (which the send leaves pointing into the
+%% block being handed over) and then a tail call, so nothing can observe it.
+%% PRIM_FORWARD_MESSAGE re-checks the shape at run time and falls back to a
+%% plain send if it does not hold, so a false positive here costs speed, never
+%% correctness.
+forwardable_receive(Rest) ->
+    forwardable_before_send(Rest, 0).
+
+forwardable_before_send(_Rest, Seen) when Seen > 8 ->
+    false;
+forwardable_before_send(<<?OP_LINE, Rest0/binary>>, Seen) ->
+    {_Line, Rest1} = decode_literal(Rest0),
+    forwardable_before_send(Rest1, Seen + 1);
+forwardable_before_send(<<?OP_BIF0, Rest0/binary>>, Seen) ->
+    {_Bif, Rest1} = decode_literal(Rest0),
+    forwardable_before_send(skip_dest(Rest1), Seen + 1);
+forwardable_before_send(<<?OP_MOVE, Rest0/binary>>, Seen) ->
+    Rest1 = skip_compact_term(Rest0),
+    forwardable_before_send(skip_dest(Rest1), Seen + 1);
+forwardable_before_send(<<?OP_PUT_TUPLE2, Rest0/binary>>, Seen) ->
+    Rest1 = skip_dest(Rest0),
+    {ListSize, Rest2} = decode_extended_list_header(Rest1),
+    Rest3 = lists:foldl(
+        fun(_Index, Acc) -> skip_compact_term(Acc) end,
+        Rest2,
+        lists:seq(1, ListSize)
+    ),
+    forwardable_before_send(Rest3, Seen + 1);
+forwardable_before_send(<<?OP_SEND, Rest/binary>>, _Seen) ->
+    forwardable_after_send(Rest);
+forwardable_before_send(_Rest, _Seen) ->
+    false.
+
+forwardable_after_send(<<?OP_LINE, Rest0/binary>>) ->
+    {_Line, Rest1} = decode_literal(Rest0),
+    forwardable_after_send(Rest1);
+forwardable_after_send(<<?OP_MOVE, Rest0/binary>>) ->
+    %% the destination must be x0, the register the send wrote
+    case skip_compact_term(Rest0) of
+        <<0:4, ?COMPACT_XREG:4, Rest1/binary>> -> forwardable_tail_call(Rest1);
+        _ -> false
+    end;
+forwardable_after_send(_Rest) ->
+    false.
+
+forwardable_tail_call(<<?OP_LINE, Rest0/binary>>) ->
+    {_Line, Rest1} = decode_literal(Rest0),
+    forwardable_tail_call(Rest1);
+forwardable_tail_call(<<?OP_CALL_LAST, _Rest/binary>>) -> true;
+forwardable_tail_call(<<?OP_CALL_ONLY, _Rest/binary>>) -> true;
+forwardable_tail_call(_Rest) -> false.
+
 skip_dest(<<_RegIndex:4, ?COMPACT_XREG:4, Rest/binary>>) -> Rest;
 skip_dest(<<_RegIndex:4, ?COMPACT_YREG:4, Rest/binary>>) -> Rest;
 skip_dest(<<_:3, 0:1, ?COMPACT_LARGE_XREG:4, _, Rest/binary>>) -> Rest;
