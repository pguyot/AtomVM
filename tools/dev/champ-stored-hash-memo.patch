+// A CHAMP_HASH_BITS-wide hash sign-extended into a small integer: the width is
+// chosen so that the result fits one on every build, 32-bit included.
+static inline term champ_hash_term(uint32_t hash)
+{
+    uint32_t h = hash & CHAMP_HASH_MASK;
+    avm_int_t value = (h & CHAMP_HASH_SIGN_BIT)
+        ? (avm_int_t) h - (avm_int_t) (CHAMP_HASH_MASK + 1)
+        : (avm_int_t) h;
+    return term_from_int(value);
+}
+
+static inline uint32_t champ_hash_of_term(term t)
+{
+    return ((uint32_t) (avm_uint_t) term_to_int(t)) & CHAMP_HASH_MASK;
+}
+
+// A one-entry memo of the last key a map iteration handed out, together with
+// the hash the trie had stored beside it. It pays for the iterate-then-look-up
+// shape -- walk one map, look each key up in another -- where the key's hash is
+// already known from the first map and would otherwise be computed again for
+// the second, which for the compound keys the Erlang compiler uses means
+// walking the whole key.
+//
+// It is keyed on the key's term, so for a boxed key on a heap address, and must
+// not outlive that address, or a later term allocated there would be handed
+// another key's hash. Only the cursor writes it, and only from maps:next, so a
+// memoized key always belongs to the process this thread is running: the
+// collector drops the memo whenever terms move, and the scheduler drops it when
+// it hands this thread a different process, which together cover every way that
+// process's heap can be reused. Being thread-local, it needs no lock and no
+// atomics.
+static __thread term champ_memo_key = 0; // term_invalid_term(): no entry
+static __thread uint32_t champ_memo_hash;
+
+void termmap_champ_memo_invalidate(void)
+{
+    champ_memo_key = term_invalid_term();
+}
+
+static inline void champ_memo_note(term key, uint32_t hash)
+{
+    champ_memo_key = key;
+    champ_memo_hash = hash;
+}
+
+static inline uint32_t champ_key_hash(term key, GlobalContext *global)
+{
+    if (key == champ_memo_key) {
+        return champ_memo_hash;
+    }
+    return term_hash(key, global) & CHAMP_HASH_MASK;
+}
