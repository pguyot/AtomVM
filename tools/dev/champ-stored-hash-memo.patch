+
+// Write entry \p i of a node under construction.
+static inline void champ_set_entry(term node, size_t i, uint32_t hash, term key, term value)
+{
+    size_t at = champ_entry_at(i);
+    term_put_tuple_element(node, at, champ_hash_term(hash));
+    term_put_tuple_element(node, at + 1, key);
+    term_put_tuple_element(node, at + 2, value);
+}
+
+// Copy entry \p si of \p src into entry \p di of a node under construction,
+// carrying the stored hash across so it never has to be recomputed.
+static inline void champ_copy_entry(term dst, size_t di, term src, size_t si)
+{
+    size_t to = champ_entry_at(di);
+    size_t from = champ_entry_at(si);
+    const term *body = champ_body(src);
+    term_put_tuple_element(dst, to, body[from]);
+    term_put_tuple_element(dst, to + 1, body[from + 1]);
+    term_put_tuple_element(dst, to + 2, body[from + 2]);
+}
+
+// As champ_copy_entry, but with a new value under the same key.
+static inline void champ_copy_entry_value(term dst, size_t di, term src, size_t si, term value)
+{
+    champ_copy_entry(dst, di, src, si);
+    term_put_tuple_element(dst, champ_entry_at(di) + 2, value);
 }
 
