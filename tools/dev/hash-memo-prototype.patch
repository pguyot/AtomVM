+// Hash memo: a term's hash depends only on its contents, and a boxed term is
+// immutable, so the only thing that can invalidate an entry keyed by the term's
+// address is a collection moving or reclaiming what lives there -- which the
+// epoch catches. The table is thread-local because the addresses in it come
+// from the heap of whichever process this scheduler is running, and that is the
+// only heap this scheduler's collections move.
+#define TERM_HASH_MEMO_SLOTS 2048
+
+struct TermHashMemoEntry
+{
+    term key;
+    uint32_t hash;
+    uint32_t epoch;
+};
+
+extern _Thread_local uint32_t term_hash_memo_epoch;
+static _Thread_local struct TermHashMemoEntry term_hash_memo[TERM_HASH_MEMO_SLOTS];
+
 uint32_t term_hash(term t, GlobalContext *global)
 {
-    return hash_term_incr(t, LARGE_PRIME_INITIAL, global);
+    // Immediates are most of the calls but almost none of the work, and there
+    // is nothing to remember about them: skip straight past the table.
+    if ((t & TERM_PRIMARY_MASK) == TERM_PRIMARY_IMMED) {
+        return hash_term_incr(t, LARGE_PRIME_INITIAL, global);
+    }
+    struct TermHashMemoEntry *entry = &term_hash_memo[(t >> 3) % TERM_HASH_MEMO_SLOTS];
+    uint32_t epoch = term_hash_memo_epoch;
+    if (entry->key == t && entry->epoch == epoch) {
+        return entry->hash;
+    }
+    uint32_t computed = hash_term_incr(t, LARGE_PRIME_INITIAL, global);
+    entry->key = t;
+    entry->hash = computed;
+    entry->epoch = epoch;
+    return computed;
 }
